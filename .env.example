# Local development — JSON store works without secrets.

# Preferred: Google AI Studio / Gemini (Mainframe chat + progress summarize)
# Server-side (local dev / API routes):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Client-side testing on GitHub Pages (exposed in bundle — TEMPORARY ONLY):
# NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash
# Or paste key in /admin/assistant sidebar (stored in localStorage).

# Fallback: OpenAI-compatible chat API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Force provider: gemini | openai (default: gemini if key set, else openai)
# AI_PROVIDER=gemini
