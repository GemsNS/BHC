# Local development — JSON store works without secrets.

# ---- Automation engine (docs/AUTOMATION.md) ----
# In-process scheduler runs every N minutes on the Node host. Set 0 to disable
# (e.g. when systemd/cron calls `npm run bhc -- automations tick` instead).
# BHC_SCHEDULER=1
# BHC_SCHEDULER_INTERVAL_MIN=15
# BHC_SCHEDULER_INITIAL_DELAY_SEC=45
# Shared secret for POST /api/automation from cron/CI (header x-bhc-automation-secret)
# AUTOMATION_SECRET=
# Nightly backups → data/backups/ (snapshots kept)
# BHC_BACKUP_KEEP=14
# Ops check thresholds
# AUTOMATION_INVOICE_DUE_DAYS=30
# AUTOMATION_INVOICE_DRAFT_DAYS=3
# AUTOMATION_JOB_SILENT_DAYS=5
# AUTOMATION_TOOL_MAX_DAYS=7
# AUTOMATION_DAMAGE_ESCALATE_HOURS=24
# AUTOMATION_FLEET_STALE_DAYS=3
# Set by deploy/production/deploy.sh for /api/health
# BHC_COMMIT=

# ---- Job-ad outreach: cold email / SMS replies to local ads (docs/OUTREACH.md) ----
# Where ads come from. Option A (recommended): a mailbox that receives Kijiji /
# Craigslist / Marketplace saved-search alert emails AND prospect replies.
# ADS_IMAP_HOST=imap.secureserver.net        # GoDaddy Workspace; M365: outlook.office365.com; Gmail: imap.gmail.com
# ADS_IMAP_PORT=993
# ADS_IMAP_USER=ads@bhcontracting.ca
# ADS_IMAP_PASS=
# ADS_IMAP_FOLDER=INBOX
# ADS_IMAP_ALERT_SENDERS=kijiji.ca,craigslist.org,facebookmail.com,homestars.com
# ADS_IMAP_MARK_SEEN=true
# ADS_IMAP_MAX=30
# Option B: push ads in from Zapier / Make / Cloudflare Email Worker → POST /api/ads/inbound
# ADS_INBOUND_SECRET=
# Triage thresholds (0–100). Ads below ADS_MIN_SCORE are skipped; ADS_AUTOSEND_MIN_SCORE gates auto-send.
# ADS_MIN_SCORE=55
# ADS_AUTOSEND_MIN_SCORE=75
# ADS_CLASSIFY_BATCH=20
# Cheaper model used only for ad triage (drafting uses ANTHROPIC_MODEL)
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Sending. Default: every reply waits for your approval in /admin/ads.
# OUTREACH_AUTOSEND=            # "email", "sms", or "email,sms" to send high-score replies without approval
# OUTREACH_DAILY_CAP=25
# OUTREACH_QUIET_HOURS=21-8     # no SMS between 9pm and 8am (server local time)
# OUTREACH_FOLLOWUP_DAYS=3
# OUTREACH_MAX_FOLLOWUPS=1
# Signature used in every reply
# OUTREACH_COMPANY_NAME=BH Contracting LTD.
# OUTREACH_COMPANY_SHORT=BH Contracting
# OUTREACH_SIGNER=Cameron
# OUTREACH_REPLY_PHONE=902-555-0100
# OUTREACH_REPLY_EMAIL=quotes@bhcontracting.ca
# OUTREACH_WEBSITE=https://bhcontracting.ca
# OUTREACH_SERVICE_AREA=Halifax Regional Municipality and surrounding Nova Scotia
# OUTREACH_SERVICES=siding, soffit & fascia, decks, windows & doors, exterior trim and full building-envelope work

# SMS via Twilio (buy a Canadian local number; point "A message comes in" at https://bhcontracting.ca/api/sms/inbound)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1902XXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=          # optional, preferred once created
# TWILIO_INBOUND_URL=https://bhcontracting.ca/api/sms/inbound   # only if a proxy rewrites the URL

# Preferred for Mainframe CRM: Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_PROVIDER=anthropic

# Optional: Google Gemini (also used for browser static-demo keys)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# Fallback: OpenAI-compatible chat API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Force provider: anthropic | gemini | openai
# AI_PROVIDER=anthropic

# AI cost controls / throttling
# AI_DAILY_REQUEST_LIMIT=200
# AI_DAILY_TOKEN_BUDGET=500000
# AI_EMPLOYEE_DAILY_REQUEST_LIMIT=80
# AI_MAX_STEPS=6
# AI_MAX_MESSAGE_CHARS=12000
# AI_MAX_HISTORY_MESSAGES=24
# RATE_LIMIT_AI_PER_MIN=20
# CONTACT_RATE_PER_HOUR=8
# PRESENTATION_UNLOCK_RATE_PER_HOUR=20
# UPLOAD_MAX_BYTES=8388608
# UPLOAD_MAX_FILES=6
# UPLOAD_RATE_PER_HOUR=40

# Optional captcha (Turnstile by default; set CAPTCHA_PROVIDER=hcaptcha for hCaptcha)
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional contact / quote form (GoDaddy SMTP or Resend — see docs/GODADDY_EMAIL_SETUP.md)
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=quotes@bhcontracting.ca
# SMTP_PASS=
# SMTP_FROM=BH Contracting LTD. <quotes@bhcontracting.ca>
# CONTACT_TO_EMAIL=info@bhcontracting.ca
# RESEND_API_KEY=

# Reserved for future Google Calendar OAuth insert (ICS works without this)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# QuickBooks Online — server OAuth (bhcontracting.ca, production)
# APP_BASE_URL=https://bhcontracting.ca
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENV=production
# QUICKBOOKS_REDIRECT_URI=https://bhcontracting.ca/api/quickbooks/callback
