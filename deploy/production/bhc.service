# /etc/systemd/system/bhc.service — BHC Next.js app on the production host
#
#   sudo cp deploy/production/bhc.service /etc/systemd/system/bhc.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now bhc
#
# The in-process automation scheduler starts with the app (BHC_SCHEDULER defaults on).
# Set BHC_SCHEDULER=0 in /opt/bhc/.env if you prefer the systemd timer below.

[Unit]
Description=BH Contracting CRM (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bhc
EnvironmentFile=-/etc/bhc/bhc.env
EnvironmentFile=-/opt/bhc/.env
EnvironmentFile=-/opt/bhc/data/deploy/runtime.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=BHC_APP_USER=www-data
Environment=BHC_APP_GROUP=www-data
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# Hardening (adjust if you store data outside /opt/bhc/data)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bhc/data /opt/bhc/.next
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
