# Example Cloud Run (v2) service — adapt PROJECT_ID, secrets, Filestore IP.
# Apply: gcloud run services replace deploy/gcp/service.yaml.example --region=us-central1
#
# Before use:
# 1. Create Artifact Registry repo and push image (see cloudbuild.yaml)
# 2. Create Filestore instance and note NFS IP
# 3. Create secrets in Secret Manager
# 4. Replace placeholders below

apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: bhc
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/maxScale: "4"
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/vpc-access-egress: all-traffic
    spec:
      containerConcurrency: 80
      timeoutSeconds: 300
      serviceAccountName: PROJECT_NUMBER-compute@developer.gserviceaccount.com
      containers:
        - image: REGION-docker.pkg.dev/PROJECT_ID/bhc/bhc:latest
          ports:
            - containerPort: 8080
          resources:
            limits:
              cpu: "1"
              memory: 1Gi
          env:
            - name: GEMINI_MODEL
              value: gemini-3.6-flash
            - name: QUICKBOOKS_ENV
              value: production
            - name: GEMINI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: GEMINI_API_KEY
                  key: latest
            - name: QUICKBOOKS_CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: QUICKBOOKS_CLIENT_ID
                  key: latest
            - name: QUICKBOOKS_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: QUICKBOOKS_CLIENT_SECRET
                  key: latest
            - name: QUICKBOOKS_REALM_ID
              valueFrom:
                secretKeyRef:
                  name: QUICKBOOKS_REALM_ID
                  key: latest
            - name: QUICKBOOKS_REFRESH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: QUICKBOOKS_REFRESH_TOKEN
                  key: latest
          volumeMounts:
            - name: bhc-data
              mountPath: /app/data
          startupProbe:
            httpGet:
              path: /api/ai/status
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /api/store
              port: 8080
            periodSeconds: 30
      volumes:
        - name: bhc-data
          nfs:
            server: FILESTORE_IP
            path: /vol1
            readOnly: false
