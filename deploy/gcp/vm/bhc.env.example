# BHC server environment — copy to /etc/bhc/bhc.env on the VM (chmod 600)
# Do not commit real keys to git.

GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini
PORT=3000

# QuickBooks (optional — add when Intuit OAuth is complete)
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REALM_ID=
# QUICKBOOKS_REFRESH_TOKEN=
# QUICKBOOKS_ENV=production

# Contact form (optional)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@bhcontracting.co
